{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "8 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "matchUpdateTypes": ["pin", "digest", "pinDigest"],
      "minimumReleaseAge": "0 days",
      "automerge": true
    },
    {
      "matchManagers": ["helm-values"],
      "matchPackageNames": ["ghcr.io/bandwidthondemand/nsi-safnari"],
      "pinDigests": false
    },
    {
      "description": "sbt-plugin probes Central at a path that 404s, so a 429 there aborts the run; read maven-metadata.xml instead",
      "matchDatasources": ["sbt-plugin"],
      "matchPackageNames": ["!com.codecommit:sbt-github-packages", "!com.typesafe.sbt:sbt-less"],
      "overrideDatasource": "maven",
      "overridePackageName": "{{packageName}}_2.12_1.0"
    },
    {
      "description": "Not on Maven Central; look them up on the sbt plugin repository only",
      "matchDatasources": ["sbt-plugin"],
      "matchPackageNames": ["com.codecommit:sbt-github-packages", "com.typesafe.sbt:sbt-less"],
      "registryUrls": ["https://repo.scala-sbt.org/scalasbt/sbt-plugin-releases"]
    },
    {
      "description": "Stay on the Scala 3.3 LTS line",
      "matchPackageNames": ["org.scala-lang:scala3-library_3"],
      "allowedVersions": "<3.4"
    },
    {
      "description": "The plugin and the library are one Play release; update them together",
      "matchPackageNames": ["org.playframework:sbt-plugin*", "org.playframework:play-*"],
      "groupName": "Play"
    },
    {
      "description": "pekko-testkit must match the Pekko version Play brings in",
      "matchPackageNames": ["org.apache.pekko:pekko-testkit*"],
      "enabled": false
    },
    {
      "description": "Test-only Jetty 9.4 under htmlunit-driver; Jetty 10+ is a different API",
      "matchPackageNames": ["org.eclipse.jetty:**", "org.eclipse.jetty.websocket:**"],
      "allowedVersions": "<9.5"
    },
    {
      "description": "plexus-xml 4 is built on Maven 4's xml API; maven-model 3.9 needs the 3.x line",
      "matchPackageNames": ["org.codehaus.plexus:plexus-xml"],
      "allowedVersions": "<4"
    },
    {
      "description": "Overrides for the Scala 3.3 compiler's jline 3; jline 4 removed APIs it uses",
      "matchPackageNames": ["org.jline:**"],
      "allowedVersions": "<4"
    },
    {
      "description": "play-specs2 3.0 is built on specs2 4; specs2 5 also drops must_==",
      "matchPackageNames": ["org.specs2:**"],
      "allowedVersions": "<5"
    },
    {
      "description": "sbt-github-packages and Play's sbt plugin have no sbt 2 release",
      "matchPackageNames": ["sbt/sbt"],
      "allowedVersions": "<2"
    },
    {
      "description": "Published to GitHub Packages, which Renovate can't read; update by hand",
      "matchPackageNames": ["nl.surfnet:**", "nl.surfnet.bod:**"],
      "enabled": false
    }
  ]
}
